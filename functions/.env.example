# Copy to ignored .env.local for local HTTP use. npm run build, then npm run start:local.
NODE_ENV=development
FIREBASE_PROJECT_ID=dev-track-46323
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PORT=10000
# Leave empty to disable AI, or enable configured providers.
EOD_AI_PROVIDERS=groq,gemini
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash-lite
# Keys belong in ignored .secret.local, or Render's secret environment setting:
# EOD_AI_KEYS='{"groq":"YOUR_GROQ_KEY","gemini":"YOUR_GEMINI_KEY"}'
# Never put API keys in VITE_* variables or commit them.
