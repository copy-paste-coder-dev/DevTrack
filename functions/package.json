{
  "name": "devtrack-functions",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "node lib/src/server.js",
    "start:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.secret.local lib/src/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
