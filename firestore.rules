rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validProfile(userId) {
      let data = request.resource.data;
      let fields = ['uid', 'displayName', 'email', 'photoURL', 'provider', 'createdAt', 'updatedAt', 'lastLoginAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.uid == userId && data.provider == 'google'
        && (data.displayName == null || data.displayName is string)
        && (data.email == null || data.email is string)
        && (data.photoURL == null || data.photoURL is string)
        && data.createdAt is timestamp
        && data.updatedAt == request.time && data.lastLoginAt == request.time;
    }
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile(userId)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) && validProfile(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'photoURL', 'updatedAt', 'lastLoginAt']);
      allow list, delete: if false;
    }
    // Activities/settings and every other collection remain unavailable in Phase 2.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
