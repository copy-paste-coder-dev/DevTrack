rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validProfile(userId) {
      let data = request.resource.data;
      let fields = ['uid', 'displayName', 'email', 'photoURL', 'provider', 'createdAt', 'updatedAt', 'lastLoginAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.uid == userId && data.provider == 'google'
        && (data.displayName == null || data.displayName is string)
        && (data.email == null || data.email is string)
        && (data.photoURL == null || data.photoURL is string)
        && data.createdAt is timestamp
        && data.updatedAt == request.time && data.lastLoginAt == request.time;
    }
    function validActivity() {
      let data = request.resource.data;
      let fields = ['dateKey', 'activityType', 'taskName', 'status', 'startAt', 'endAt', 'durationMinutes', 'notes', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.dateKey is string && data.dateKey.matches('^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$')
        && data.activityType in ['jira_task', 'scrum_call', 'meeting', 'development', 'bug_fix', 'code_review', 'testing', 'break', 'other']
        && data.status in ['in_progress', 'on_hold', 'completed']
        && data.taskName is string && data.taskName.size() > 0 && data.taskName.size() <= 160
        && data.notes is string && data.notes.size() <= 1000
        && data.startAt is timestamp && data.endAt is timestamp && data.endAt > data.startAt
        && data.durationMinutes is int && data.durationMinutes > 0 && data.durationMinutes <= 1500
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function validPreferences() {
      let data = request.resource.data;
      let fields = ['dayStartTime', 'dayEndTime', 'timeFormat', 'enabledActivityTypes', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.dayStartTime is string && data.dayStartTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.dayEndTime is string && data.dayEndTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.dayEndTime > data.dayStartTime
        && data.timeFormat in ['12h', '24h']
        && data.enabledActivityTypes is list && data.enabledActivityTypes.size() > 0
        && data.enabledActivityTypes.size() <= 9
        && data.enabledActivityTypes.toSet().size() == data.enabledActivityTypes.size()
        && data.enabledActivityTypes.hasOnly(['jira_task', 'scrum_call', 'meeting', 'development', 'bug_fix', 'code_review', 'testing', 'break', 'other'])
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile(userId)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) && validProfile(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'photoURL', 'updatedAt', 'lastLoginAt']);
      allow list, delete: if false;
      match /activities/{activityId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && validActivity()
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && validActivity()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['dateKey', 'activityType', 'taskName', 'status', 'startAt', 'endAt', 'durationMinutes', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId);
      }
      match /settings/{settingsId} {
        allow get: if isOwner(userId) && settingsId == 'preferences';
        allow create: if isOwner(userId) && settingsId == 'preferences' && validPreferences()
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && settingsId == 'preferences' && validPreferences()
          && (('createdAt' in resource.data && request.resource.data.createdAt == resource.data.createdAt)
            || (!('createdAt' in resource.data) && request.resource.data.createdAt == request.time))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dayStartTime', 'dayEndTime', 'timeFormat', 'enabledActivityTypes', 'createdAt', 'updatedAt']);
        allow list, delete: if false;
      }
    }
    // Every unlisted collection remains unavailable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
